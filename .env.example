APP_BASE_URL=http://localhost:8000
FRONTEND_ORIGINS=["http://localhost:8000","http://localhost:8001"]
CORS_ALLOW_ALL=false
CLIENT_URL=http://localhost:8001/prism.html
DATABASE_URL=postgresql+asyncpg://prism:prism@localhost:5432/prism
AUTH_JWT_SECRET=change-me-to-a-long-random-string
TOKEN_ENCRYPTION_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/auth/gmail/callback
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-3-5-sonnet-20240620
# LLM_PROVIDER can be: anthropic, openai, gemini
# For gemini, set LLM_MODEL to a Gemini model (e.g. gemini-1.5-flash)
# Update tracker: set a newer version + URL only when a release actually exists.
# Leave empty = dashboard shows "up to date".
LATEST_VERSION=
UPDATE_URL=